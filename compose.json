{
  "name": "echodoc",
  "services": {
    "backend": {
      "build": { "context": ".", "target": "backend" },
      "init": true,
      "environment": {
        "APP_BIND": "0.0.0.0:50051",
        "AI_ADDRESS": "ai:50052",
        "DATABASE_PATH": "/data/documents.sqlite3",
        "USERS_PATH": "/data/users.json"
      },
      "volumes": ["documents:/data"]
    },
    "ai": {
      "build": { "context": ".", "target": "ai" },
      "init": true,
      "environment": { "AI_BIND": "0.0.0.0:50052" },
      "volumes": ["model-cache:/models"]
    },
    "envoy": {
      "image": "envoyproxy/envoy:v1.38.3",
      "command": ["envoy", "-c", "/etc/envoy/envoy.json", "--log-level", "error"],
      "volumes": ["./deploy/envoy.json:/etc/envoy/envoy.json:ro"],
      "depends_on": ["backend"]
    },
    "web": {
      "build": { "context": ".", "target": "web" },
      "ports": ["127.0.0.1:${ECHODOC_PORT:-5273}:80"],
      "depends_on": ["envoy"]
    }
  },
  "volumes": { "documents": {}, "model-cache": {} }
}
