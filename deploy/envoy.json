{
  "static_resources": {
    "listeners": [
      {
        "name": "browser_listener",
        "address": {
          "socket_address": {
            "address": "0.0.0.0",
            "port_value": 8080
          }
        },
        "filter_chains": [
          {
            "filters": [
              {
                "name": "envoy.filters.network.http_connection_manager",
                "typed_config": {
                  "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
                  "stat_prefix": "browser_rpc",
                  "codec_type": "AUTO",
                  "stream_idle_timeout": "60s",
                  "route_config": {
                    "name": "rpc_routes",
                    "virtual_hosts": [
                      {
                        "name": "python_service",
                        "domains": [
                          "*"
                        ],
                        "routes": [
                          {
                            "match": {
                              "prefix": "/collab.ai.v1.WritingService/"
                            },
                            "route": {
                              "cluster": "python_backend",
                              "timeout": "50s"
                            }
                          },
                          {
                            "match": {
                              "prefix": "/"
                            },
                            "route": {
                              "cluster": "python_backend",
                              "timeout": "0s",
                              "idle_timeout": "0s"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  "http_filters": [
                    {
                      "name": "envoy.filters.http.grpc_web",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.grpc_web.v3.GrpcWeb"
                      }
                    },
                    {
                      "name": "envoy.filters.http.router",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
                      }
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ],
    "clusters": [
      {
        "name": "python_backend",
        "type": "STRICT_DNS",
        "connect_timeout": "0.5s",
        "lb_policy": "ROUND_ROBIN",
        "common_lb_config": {
          "healthy_panic_threshold": {
            "value": 0
          }
        },
        "health_checks": [
          {
            "timeout": "0.5s",
            "interval": "1s",
            "no_traffic_interval": "1s",
            "unhealthy_threshold": 2,
            "healthy_threshold": 1,
            "tcp_health_check": {}
          }
        ],
        "typed_extension_protocol_options": {
          "envoy.extensions.upstreams.http.v3.HttpProtocolOptions": {
            "@type": "type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions",
            "explicit_http_config": {
              "http2_protocol_options": {}
            }
          }
        },
        "load_assignment": {
          "cluster_name": "python_backend",
          "endpoints": [
            {
              "lb_endpoints": [
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "app-1",
                        "port_value": 50051
                      }
                    }
                  }
                },
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "app-2",
                        "port_value": 50051
                      }
                    }
                  }
                },
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "app-3",
                        "port_value": 50051
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
